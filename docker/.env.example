# docker compose 的变量文件（本机开发专用）。复制为 .env 后修改：
#   cp docker/.env.example docker/.env
# 或执行 docker/dev-stack.ps1 init（自动生成随机密码）。
# .env 已被 .gitignore 忽略，密码不要提交到仓库；这几个值只在 127.0.0.1 上生效。
# 说明见 docs/07-deployment/02-本机开发环境（Docker）.md

# ---- 密码（本机，任意值即可）----
POSTGRES_ADMIN_PASSWORD=<本机 postgres 超级用户密码>
AICS_DB_PASSWORD=<aics 角色密码，应用用它连 aics / aics_test>
AICS_REDIS_PASSWORD=<aics 用户密码（Redis ACL）>
AICS_MQ_PASSWORD=<aics 用户密码（RabbitMQ）>
AICS_QDRANT_API_KEY=<Qdrant API Key>

# ---- 端口（默认与服务器一致，本机端口被占用时才改）----
AICS_DB_PORT=5432
AICS_REDIS_PORT=6379
AICS_MQ_PORT=5672
AICS_MQ_UI_PORT=15672
AICS_QDRANT_PORT=6333
AICS_QDRANT_GRPC_PORT=6334
