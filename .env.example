# ============ AICS 环境变量示例（复制为 .env 后填写，.env 不入库）============
# 说明见 docs/06-development/05-配置与环境变量.md

# ---- 应用 ----
AICS_ENV=dev                         # dev / test / prod
AICS_DEBUG=false
AICS_API_HOST=0.0.0.0
AICS_API_PORT=8000
AICS_CORS_ORIGINS=http://localhost:5173
AICS_LOG_LEVEL=INFO
AICS_LOG_JSON=true

# ---- 安全 ----
AICS_JWT_SECRET=<随机64位以上字符串>
AICS_JWT_ACCESS_TTL_MIN=30
AICS_JWT_REFRESH_TTL_DAYS=7
AICS_API_KEY_PEPPER=<随机32位以上字符串>
AICS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AICS_BOOTSTRAP_ADMIN_PASSWORD=<首次启动后立即修改>

# ---- PostgreSQL（复用服务器 db-postgres-1）----
AICS_DB_URL=postgresql+asyncpg://aics:<AICS_DB_PASSWORD>@192.168.110.86:5432/aics
AICS_DB_POOL_SIZE=10
AICS_DB_MAX_OVERFLOW=10

# ---- Redis（复用，独立库号 + 前缀）----
AICS_REDIS_URL=redis://:<REDIS_PASSWORD>@192.168.110.86:6379/5
AICS_REDIS_PREFIX=aics:

# ---- RabbitMQ（复用，独立 vhost）----
AICS_CELERY_BROKER_URL=amqp://aics:<AICS_MQ_PASSWORD>@192.168.110.86:5672/aics
AICS_CELERY_RESULT_BACKEND=redis://:<REDIS_PASSWORD>@192.168.110.86:6379/6

# ---- Qdrant（本项目自建）----
AICS_QDRANT_URL=http://192.168.110.86:6333
AICS_QDRANT_API_KEY=<QDRANT_API_KEY>

# ---- 文件存储 ----
AICS_STORAGE_BACKEND=local           # local / s3（v2）
AICS_STORAGE_LOCAL_ROOT=./storage
AICS_UPLOAD_MAX_MB=50

# ---- 对话模型（DeepSeek，OpenAI 兼容）----
AICS_LLM_PROVIDER=openai_compatible
AICS_LLM_BASE_URL=https://api.deepseek.com
AICS_LLM_API_KEY=<DEEPSEEK_API_KEY>
AICS_LLM_MODEL=deepseek-flash
AICS_LLM_TIMEOUT_S=60

# ---- 向量化（阿里云百炼，OpenAI 兼容模式）----
AICS_EMBED_PROVIDER=dashscope
AICS_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AICS_EMBED_API_KEY=<DASHSCOPE_API_KEY>
AICS_EMBED_MODEL=text-embedding-v4
AICS_EMBED_DIM=1024
AICS_EMBED_BATCH=10

# ---- 重排序（阿里云百炼）----
AICS_RERANK_PROVIDER=dashscope
AICS_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
AICS_RERANK_API_KEY=<DASHSCOPE_API_KEY>
AICS_RERANK_MODEL=qwen3-rerank

# ---- 可观测（可选）----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=<可选>
LANGSMITH_PROJECT=aics-dev
